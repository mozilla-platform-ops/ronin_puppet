# ==============================================================================
# PUPPET RUN METADATA: Source state writing function library
# ==============================================================================
# This script writes puppet run metadata to /etc/puppet/last_run_metadata.json
# after each puppet run, enabling ground-truth tracking of applied configuration.
# The metadata includes git SHA, success status, duration, and file checksums.
#
# See: docs/puppet-state-tracking.md for details
if [ -f "/etc/puppet/lib/puppet_state_functions.sh" ]; then
    # shellcheck disable=SC1091
    source "/etc/puppet/lib/puppet_state_functions.sh"
else
    echo "WARNING: Could not load state writing function from /etc/puppet/lib/puppet_state_functions.sh" >&2
fi
# ==============================================================================

function fail {
    # TODO: report failure to ext service
    echo "${@}"
    exit 1
}

# This checkout is fetched and applied by root. Keep it root-owned and
# inaccessible for modification by task users.
function require_root_owned_directory {
    local path="$1"
    local owner group mode

    [ -d "${path}" ] && [ ! -L "${path}" ] || fail "Unsafe directory: ${path}"
    owner=$(stat -c '%u' "${path}") || fail "Unable to stat ${path}"
    group=$(stat -c '%g' "${path}") || fail "Unable to stat ${path}"
    mode=$(stat -c '%a' "${path}") || fail "Unable to stat ${path}"
    [ "${owner}" = '0' ] && [ "${group}" = '0' ] || fail "Directory is not root:root: ${path}"
    (( (8#${mode} & 8#022) == 0 )) || fail "Directory is writable by group or other: ${path}"
}

function protect_git_metadata {
    local config="${WORKING_DIR}/.git/config"
    local owner group mode links

    require_root_owned_directory "${WORKING_DIR}/.git"
    chmod 0700 "${WORKING_DIR}/.git" || fail "Unable to protect Git metadata"
    if [ -e "$config" ] || [ -L "$config" ]; then
        [ -f "$config" ] && [ ! -L "$config" ] || fail "Unsafe Git config"
        owner=$(stat -c '%u' "$config") || fail "Unable to validate Git config"
        group=$(stat -c '%g' "$config") || fail "Unable to validate Git config"
        mode=$(stat -c '%a' "$config") || fail "Unable to validate Git config"
        links=$(stat -c '%h' "$config") || fail "Unable to validate Git config"
        [ "$owner" = 0 ] && [ "$group" = 0 ] && [ "$links" = 1 ] \
          || fail "Unsafe Git config ownership or link count"
        (( (8#${mode} & 8#022) == 0 )) || fail "Git config is writable by group or other"
        chmod 0600 "$config" || fail "Unable to protect Git config"
    fi
}

function clear_git_pat_auth {
    local result
    GIT_PAT_HEADER=''
    export -n GIT_PAT_HEADER
    if [ -e "${WORKING_DIR}/.git" ] || [ -L "${WORKING_DIR}/.git" ]; then
        protect_git_metadata
        if [ -f "${WORKING_DIR}/.git/config" ]; then
            # Restrict legacy credentials before Git rewrites the config. Code
            # 5 means the header is absent; every other failure is significant.
            if (umask 077; git config --local --unset-all http.https://github.com/.extraHeader) 2>/dev/null; then
                result=0
            else
                result=$?
            fi
            [ "$result" = 0 ] || [ "$result" = 5 ] || fail "Unable to remove legacy Git authentication"
            protect_git_metadata
        fi
    fi
}

function require_secure_working_dir {
    local unsafe_path link_path relative_path link_owner link_group

    require_root_owned_directory "${WORKING_DIR}"

    # A .git file can redirect Git to an arbitrary directory, so only accept a
    # root-owned directory. Git checkout also leaves untracked files intact.
    if [ -e "${WORKING_DIR}/.git" ] || [ -L "${WORKING_DIR}/.git" ]; then
        protect_git_metadata
    fi
    unsafe_path=$(find "${WORKING_DIR}" -xdev ! -type l \( ! -user root -o ! -group root -o -perm /022 \) -print -quit) || fail "Unable to validate Puppet checkout: ${WORKING_DIR}"
    [ -z "${unsafe_path}" ] || fail "Puppet checkout contains unsafe files: ${unsafe_path}"

    # The repository deliberately tracks test-fixture symlinks.  Accept only
    # tracked root-owned links; untracked links still fail closed.
    while IFS= read -r -d '' link_path; do
        relative_path="${link_path#"${WORKING_DIR}/"}"
        link_owner=$(stat -c '%u' "${link_path}") || fail "Unable to stat symlink: ${link_path}"
        link_group=$(stat -c '%g' "${link_path}") || fail "Unable to stat symlink: ${link_path}"
        [ "${link_owner}" = '0' ] && [ "${link_group}" = '0' ] \
          || fail "Puppet checkout contains unsafe symlink: ${link_path}"
        git -C "${WORKING_DIR}" ls-files --error-unmatch -- "${relative_path}" >/dev/null 2>&1 \
          || fail "Puppet checkout contains untracked symlink: ${link_path}"
    done < <(find "${WORKING_DIR}" -xdev -type l -print0)
}

function remove_staged_vault_secrets {
    local secrets_dir="${WORKING_DIR}/data/secrets"

    # The Linux Hiera config reads /root/vault.yaml directly. This removes a
    # legacy copy only after require_secure_working_dir has validated the tree.
    rm -f -- "${secrets_dir}/vault.yaml" || return 1
    rmdir "${secrets_dir}" 2>/dev/null || true
}

# Lifecycle logging is observational only: no failure may interrupt Puppet.
function lifecycle_log {
    if [ -x /usr/local/bin/lifecycle-log ]; then
        if ! /usr/local/bin/lifecycle-log "$@"; then
            echo "lifecycle-log $* failed; continuing without lifecycle event" >&2
        fi
    fi
}

# Return true is valid IP and not APIPA address
function valid_ip {
    local IP=$1
    local STAT=1
    if [[ $IP =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
        OIFS=$IFS
        IFS='.'
        IP=($IP)
        IFS=$OIFS
        ( ! [[ ${IP[0]} -eq 169 && ${IP[1]} -eq 254 ]]) && \
        (   [[ ${IP[0]} -le 255 && ${IP[1]} -le 255 && \
               ${IP[2]} -le 255 && ${IP[3]} -le 255 ]])
        STAT=$?
    fi
    return $STAT
}

function block_on_network {
    local delay=1
    while true; do
        interface=$(route get 1.1.1.1 | grep interface | cut -d\: -f2)
        ifconfig $interface 2>&1 >/dev/null || interface="en0"
        IP=$(ipconfig getifaddr $interface)
        if valid_ip $IP; then
            echo "Network connectivity check passed $IP"
            break
        else
            echo "Network connectivity failed; retry in ${delay}s"
            sleep $delay
            (( delay *= delay<60?2:1 ))
        fi
    done
}

function email_report {
    (
        # Keep large, untrusted Puppet logs out of Python source and environment.
        umask 077
        report_dir=$(mktemp -d /root/puppet-email.XXXXXX) || return 1
        trap 'rm -rf -- "${report_dir}"' EXIT
        trap 'exit 1' HUP INT TERM
        printf '%s' "$2" > "${report_dir}/body" || return 1

        REPORT_SENDER="root@${FQDN}" REPORT_RECEIVER="${PUPPET_MAIL}" \
          REPORT_SUBJECT="$1" \
          REPORT_SMTP_HOST=<%= require 'shellwords'; Shellwords.escape(@smtp_relay_host) %> \
          "${PYTHON_BIN}" - "${report_dir}/body" <<'PYEOF'
import os
import smtplib
import sys
from email.message import EmailMessage

try:
    msg = EmailMessage()
    msg["From"] = os.environ["REPORT_SENDER"]
    msg["To"] = os.environ["REPORT_RECEIVER"]
    msg["Subject"] = os.environ["REPORT_SUBJECT"]
    with open(sys.argv[1], encoding="utf-8", errors="replace") as report:
        msg.set_content(report.read())
    with smtplib.SMTP(os.environ["REPORT_SMTP_HOST"]) as smtp:
        smtp.send_message(
            msg, from_addr=os.environ["REPORT_SENDER"],
            to_addrs=[os.environ["REPORT_RECEIVER"]],
        )
    print("Successfully sent email")
except (smtplib.SMTPException, OSError, ValueError) as error:
    print("Error: unable to send email")
    print(error)
    sys.exit(1)
PYEOF
    )
}

function configure_git_pat_auth {
    local GH_PAT GH_PAT_USER b64
    export -n GH_PAT GH_PAT_USER b64
    clear_git_pat_auth
    # GH PAT auth defaults to enabled
    GH_PAT_AUTH=1
    # if YQ_PRESENT=0, disable GH PAT auth
    if [ "$YQ_PRESENT" = "0" ]; then
        echo "yq-er not present, disabling GH PAT auth configuration"
        GH_PAT_AUTH=0
    fi
    # add a way of disabling GH PAT AUTH (even if yq-er is present)
    SKIP_GH_PAT_AUTH=${SKIP_GH_PAT_AUTH:-0}
    if [ "$SKIP_GH_PAT_AUTH" = "1" ]; then
        echo "SKIP_GH_PAT_AUTH is set to 1, skipping GH PAT auth configuration"
        # disable gh pat auth
        GH_PAT_AUTH=0
    fi
    # if GH_PAT_AUTH=1, proceed with configuring GH PAT auth
    if [ "$GH_PAT_AUTH" = "1" ]; then
        # check if keys are present in config file
        # TODO: add actual key checking logic here
        GH_PAT=$($YQ_BIN .github.pat /root/vault.yaml 2>/dev/null)
        GH_PAT_USER=$($YQ_BIN .github.pat_user /root/vault.yaml 2>/dev/null)
        # if they're both non-empty, set the extraHeader config
        if [ -n "$GH_PAT" ] && [ -n "$GH_PAT_USER" ]; then
            # base64 encode the credentials
            b64=$(printf '%s:%s' "$GH_PAT_USER" "$GH_PAT" | base64 -w0 2>/dev/null || printf '%s:%s' "$GH_PAT_USER" "$GH_PAT" | base64)
            # Keep this shell variable unexported. Only the fetch subprocess
            # receives it; credentials never become Git config or argv.
            GIT_PAT_HEADER="Authorization: Basic ${b64//$'\n'/}"
            echo "GitHub PAT authentication is enabled."
        else
            echo "GitHub PAT or PAT_USER is empty; skipping GH PAT auth configuration"
        fi
    fi
}

function root_owned_file_has_mode {
    local path="$1"
    local permitted_mode="$2"
    local owner group mode

    [ -f "${path}" ] && [ ! -L "${path}" ] || return 1
    owner=$(stat -c '%u' "${path}") || return 1
    group=$(stat -c '%g' "${path}") || return 1
    mode=$(stat -c '%a' "${path}") || return 1
    [ "${owner}" = '0' ] && [ "${group}" = '0' ] || return 1
    (( (8#${mode} & ~8#${permitted_mode}) == 0 )) || return 1
}

function select_puppet_repository_profile {
    case "${PUPPET_REPO}" in
        'https://github.com/mozilla-platform-ops/ronin_puppet.git' | \
        'https://github.com/aerickson/ronin_puppet-private.git' | \
        'https://github.com/mozilla-platform-ops/ronin_puppet-private.git')
            ;;
        *)
            return 1
            ;;
    esac

    PUPPET_REPOSITORY_SLUG="${PUPPET_REPO#https://github.com/}"
    PUPPET_REPOSITORY_SLUG="${PUPPET_REPOSITORY_SLUG%.git}"
    WORKING_DIR="/etc/puppet/environments/${PUPPET_REPOSITORY_SLUG}/code"
    GITHUB_DEPLOY_KEY_NAME="${PUPPET_REPOSITORY_SLUG//\//_}"
    GITHUB_DEPLOY_KEY_NAME="${GITHUB_DEPLOY_KEY_NAME//-/_}"
    GITHUB_DEPLOY_KEY_PATH="/root/.ssh/${GITHUB_DEPLOY_KEY_NAME}_deploy_key"
    GIT_REMOTE_URL="ssh://git@ssh.github.com:443/${PUPPET_REPOSITORY_SLUG}.git"
}

function deploy_key_is_available {
    select_puppet_repository_profile \
      && [ -s "${GITHUB_DEPLOY_KEY_PATH}" ] \
      && root_owned_file_has_mode "${GITHUB_DEPLOY_KEY_PATH}" 0600 \
      && [ -s "${GITHUB_KNOWN_HOSTS_PATH}" ] \
      && root_owned_file_has_mode "${GITHUB_KNOWN_HOSTS_PATH}" 0644
}

function configure_deploy_key_auth {
    deploy_key_is_available || return 1

    export GIT_SSH_COMMAND="ssh -F /dev/null -i ${GITHUB_DEPLOY_KEY_PATH} -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${GITHUB_KNOWN_HOSTS_PATH} -o GlobalKnownHostsFile=/dev/null"
    GIT_AUTH_MODE_SELECTED='deploy-key'
    clear_git_pat_auth
}

function configure_pat_auth {
    GIT_REMOTE_URL="${PUPPET_REPO}"
    unset GIT_SSH_COMMAND
    GIT_AUTH_MODE_SELECTED='pat'
    configure_git_pat_auth
}

function configure_public_anonymous_auth {
    [ "${PUPPET_REPO}" = 'https://github.com/mozilla-platform-ops/ronin_puppet.git' ] \
      || return 1

    GIT_REMOTE_URL="${PUPPET_REPO}"
    unset GIT_SSH_COMMAND
    GIT_AUTH_MODE_SELECTED='anonymous'
    clear_git_pat_auth
    configure_git_remote
}

function fetch_puppet_remote {
    if [ "${GIT_AUTH_MODE_SELECTED}" = 'anonymous' ]; then
        # Do not inherit a credential helper or GitHub auth header from a
        # system/global config when using the public, unauthenticated path.
        GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false git -c credential.helper= \
          -c http.https://github.com/.extraHeader= fetch --prune origin
    elif [ "${GIT_AUTH_MODE_SELECTED}" = pat ] && [ -n "${GIT_PAT_HEADER:-}" ]; then
        (
            # GIT_CONFIG_PARAMETERS is also supported by Ubuntu 18.04's Git.
            # Its single-quoted value is safe because Basic credentials are
            # base64. Disable diagnostic traces that could expose HTTP headers.
            unset GIT_TRACE GIT_TRACE_PACKET GIT_TRACE_CURL GIT_CURL_VERBOSE
            unset GIT_TRACE_SETUP GIT_TRACE2 GIT_TRACE2_EVENT GIT_TRACE2_PERF
            GIT_CONFIG_PARAMETERS="'http.https://github.com/.extraHeader=' 'http.https://github.com/.extraHeader=${GIT_PAT_HEADER}'" \
              GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false \
              git -c credential.helper= fetch --all --prune
        )
    else
        git fetch --all --prune
    fi
}

function configure_git_remote {
    if git rev-parse --git-dir >/dev/null 2>&1 \
      && git remote get-url origin >/dev/null 2>&1; then
        git remote set-url origin "${GIT_REMOTE_URL}" || return 1
    fi
}

function configure_git_auth {
    local requested_mode="${RUN_PUPPET_GIT_AUTH_MODE:-auto}"

    case "${requested_mode}" in
        auto)
            if deploy_key_is_available; then
                configure_deploy_key_auth || return 1
            else
                configure_pat_auth
            fi
            ;;
        pat)
            configure_pat_auth
            ;;
        deploy-key)
            configure_deploy_key_auth || {
                echo "Deploy-key authentication was requested but is not ready" >&2
                return 1
            }
            ;;
        anonymous)
            configure_public_anonymous_auth || {
                echo "Anonymous authentication is only supported for the public mozilla-platform-ops/ronin_puppet repository" >&2
                return 1
            }
            ;;
        *)
            echo "Invalid RUN_PUPPET_GIT_AUTH_MODE: ${requested_mode}" >&2
            return 1
            ;;
    esac

    configure_git_remote || return 1
    echo "Git authentication: ${GIT_AUTH_MODE_SELECTED}"
    if [ "${GIT_AUTH_MODE_SELECTED}" = 'deploy-key' ]; then
        echo "  key: ${GITHUB_DEPLOY_KEY_PATH}"
    fi
}

function init_git_working_dir {
    (umask 077; git init) || return 1
    protect_git_metadata
    git remote add origin "${GIT_REMOTE_URL}" || return 1
    if [ "${GIT_AUTH_MODE_SELECTED}" = pat ]; then
        configure_git_pat_auth || return 1
    fi
}

function reinit_working_dir {
    echo "Re-initializing git repo from scratch..."
    # Remove contents but stay in the directory (shell cwd)
    rm -rf "${WORKING_DIR:?}"/* "${WORKING_DIR}"/.[!.]*
    init_git_working_dir
}

function update_puppet {
    require_secure_working_dir
    echo -e "${_GREEN}Checkout security: root-owned and validated${_RESET}"

    # Initialize working dir if dir is empty
    if [ ! "$(find "$WORKING_DIR" -mindepth 1 -print -quit 2>/dev/null)" ]; then
        init_git_working_dir || return 1
    fi

    # TODO: authenticate the remote actions

    # Proactively remove empty/corrupted object files before fetching.
    # git fetch can return exit code 0 even when unpack-objects fails due to
    # corruption, so checking exit code alone is not reliable.
    empty_count=$(find .git/objects -type f -empty 2>/dev/null | wc -l)
    if [ "$empty_count" -gt 0 ]; then
        echo "Found $empty_count empty object file(s) before fetch; removing..."
        find .git/objects -type f -empty -delete
    fi

    # Fetch and checkout production branch
    echo -e "Syncing ronin-puppet client (repository: ${PUPPET_REPOSITORY_SLUG})..."
    echo -e "  dir: ${WORKING_DIR}"
    echo ""
    _head_before=$(git rev-parse --verify HEAD 2>/dev/null || true)
    _fetch_out=$(fetch_puppet_remote 2>&1)
    _fetch_exit=$?
    if [[ -n "$_fetch_out" ]]; then
        echo "$_fetch_out" | while IFS= read -r line; do echo -e "  ${_DIM}${line}${_RESET}"; done
    else
        echo -e "  ${_DIM}(no output)${_RESET}"
    fi
    if [[ $_fetch_exit -ne 0 ]]; then
        if [ "${RUN_PUPPET_GIT_AUTH_MODE:-auto}" = 'auto' ] \
          && { [ "${GIT_AUTH_MODE_SELECTED}" = 'deploy-key' ] \
            || [ "${GIT_AUTH_MODE_SELECTED}" = 'pat' ]; } \
          && [ "${PUPPET_REPO}" = 'https://github.com/mozilla-platform-ops/ronin_puppet.git' ]; then
            echo -e "${_YELLOW}[WARN] ${GIT_AUTH_MODE_SELECTED} fetch failed; trying unauthenticated HTTPS for the public repository${_RESET}"
            configure_public_anonymous_auth || return 1
            _fetch_out=$(fetch_puppet_remote 2>&1)
            _fetch_exit=$?
            [[ -n "$_fetch_out" ]] && echo "$_fetch_out" | while IFS= read -r line; do echo -e "  ${_DIM}${line}${_RESET}"; done
            if [[ $_fetch_exit -eq 0 ]]; then
                echo -e "${_YELLOW}[WARN] Public repository fetch succeeded without authentication; investigate the selected Git authentication${_RESET}"
            else
                echo "Unauthenticated public repository fetch also failed; leaving the checkout intact" >&2
                return 1
            fi
        fi
    fi
    if [[ $_fetch_exit -ne 0 ]]; then
        echo "git fetch failed; re-cloning..."
        reinit_working_dir || return 1
        _fetch_out=$(fetch_puppet_remote 2>&1)
        _fetch_exit=$?
        [[ -n "$_fetch_out" ]] && echo "$_fetch_out" | while IFS= read -r line; do echo -e "  ${_DIM}${line}${_RESET}"; done
        [[ $_fetch_exit -eq 0 ]] || return 1
    fi
    git checkout --quiet --force "origin/${PUPPET_BRANCH}" \
      || (
      git remote rm upstream
      git remote rename origin upstream
      git remote add origin "${GIT_REMOTE_URL}"
      git checkout --quiet --force "origin/${PUPPET_BRANCH}"
    ) || return 1
    _head_after=$(git rev-parse --verify HEAD 2>/dev/null || true)
    echo ""
    if [[ -n "$_head_before" && -n "$_head_after" && "$_head_before" != "$_head_after" ]]; then
      echo -e "  prev: $(git log -1 --oneline "$_head_before")"
      echo -e "${_CYAN}  HEAD: $(git log -1 --oneline "$_head_after")${_RESET}"
    else
      echo -e "  prev: $(git log -1 --oneline "$_head_after")"
      echo -e "${_CYAN}  HEAD: (same, up to date)${_RESET}"
    fi

    require_secure_working_dir
    remove_staged_vault_secrets || return 1

    cat <<EOF > "${WORKING_DIR}/manifests/nodes/nodes.pp"
node '${FQDN}' {
    include ::roles_profiles::roles::${ROLE}
}
EOF

    return 0
}

function recover_interrupted_dpkg {
    if ! command -v dpkg >/dev/null 2>&1; then
        return 0
    fi

    DPKG_AUDIT_OUT=$(dpkg --audit 2>&1)
    DPKG_UPDATES_PENDING=0
    if [ -d /var/lib/dpkg/updates ] && find /var/lib/dpkg/updates -type f -print -quit 2>/dev/null | grep -q .; then
        DPKG_UPDATES_PENDING=1
    fi

    if [ -z "${DPKG_AUDIT_OUT}" ] && [ "${DPKG_UPDATES_PENDING}" -eq 0 ]; then
        return 0
    fi

    if [ "${DPKG_UPDATES_PENDING}" -eq 0 ] && ! echo "${DPKG_AUDIT_OUT}" | grep -Eiq 'dpkg was interrupted|unpacked but not yet configured|half-configured|triggers-pending'; then
        echo "dpkg audit found package issues that do not match automatic recovery criteria:"
        echo "${DPKG_AUDIT_OUT}" | sed 's/^/  /'
        return 0
    fi

    echo "Detected interrupted dpkg state; running dpkg --configure -a before puppet apply..."
    if [ -n "${DPKG_AUDIT_OUT}" ]; then
        echo "${DPKG_AUDIT_OUT}" | sed 's/^/  /'
    fi
    if [ "${DPKG_UPDATES_PENDING}" -eq 1 ]; then
        echo "  pending dpkg update files found in /var/lib/dpkg/updates"
    fi

    DPKG_CONFIGURE_OUT=$(dpkg --configure -a 2>&1)
    DPKG_CONFIGURE_RETVAL=$?
    if [ -n "${DPKG_CONFIGURE_OUT}" ]; then
        echo "${DPKG_CONFIGURE_OUT}" | sed 's/^/  /'
    fi
    if [ ${DPKG_CONFIGURE_RETVAL} -ne 0 ]; then
        echo "dpkg --configure -a failed with exit code ${DPKG_CONFIGURE_RETVAL}"
        return ${DPKG_CONFIGURE_RETVAL}
    fi

    return 0
}

function run_puppet {

    # Always bring the puppet git up-to-sync before executing puppet
    if ! update_puppet; then
        echo "Failed to update puppet"
        return 1
    fi
    echo ""

    if ! recover_interrupted_dpkg; then
        return 1
    fi
    echo ""

    TMP_LOG=$(mktemp /tmp/puppet-output.XXXXXX)
    [ -f "${TMP_LOG}" ] || fail "Failed to mktemp puppet log file"

    PUPPET_OPTIONS=("--modulepath=${WORKING_DIR}/modules:${WORKING_DIR}/r10k_modules" '--hiera_config=./hiera-linux.yaml' '--logdest=console' '--color=false' '--detailed-exitcodes' './manifests/')
    SECONDS=0

    PUPPET_CMD="${PUPPET_BIN} apply ${PUPPET_OPTIONS[*]}"
    echo "Running puppet apply..."
    echo "  cmd: ${PUPPET_CMD}"
    echo ""
    # START: don't separate these two commands
    $PUPPET_CMD 2>&1 | tee "${TMP_LOG}" | while IFS= read -r line; do echo -e "  ${_DIM}${line}${_RESET}"; done
    retval=${PIPESTATUS[0]}  # use pipestatus because tee masks the return value otherwise
    # END: don't separate these two commands
    PUPPET_RUN_DURATION=$SECONDS
    case $retval in
        0) explanation="no changes needed" ;;
        2) explanation="changes applied" ;;
        *) explanation="retval $retval" ;;
    esac
    echo ""
    if [ $retval -eq 0 ] || [ $retval -eq 2 ]; then
        echo -e "${_GREEN}  [PASS] puppet apply — ${explanation} (${PUPPET_RUN_DURATION}s)${_RESET}"
    else
        echo -e "${_RED}  [FAIL] puppet apply — ${explanation} (${PUPPET_RUN_DURATION}s)${_RESET}"
    fi
    # if retval is zero, check the logs for errors
    if [ $retval -eq 0 ]; then
        # just in case, if there were any errors logged, flag it as an error run
        if grep -q "^Error:" "${TMP_LOG}"
        then
            echo "Error found in puppet log, setting retval to 1"
            retval=1
        fi
    fi
    LOG_OUT=$(cat "${TMP_LOG}")
    rm "${TMP_LOG}"

    # ==============================================================================
    # PUPPET RUN METADATA: Write state metadata
    # ==============================================================================
    # Write metadata about this puppet run to /etc/puppet/last_run_metadata.json
    # This provides ground truth for monitoring and tracking applied configuration.
    # The function is designed to never fail the puppet run.
    if type write_puppet_state >/dev/null 2>&1; then
        _state_out=$(write_puppet_state "$WORKING_DIR" "$ROLE" "$retval" "$PUPPET_RUN_DURATION" \
            "/etc/puppet/ronin_settings" "/root/vault.yaml" 2>&1)
        _state_file=$(echo "$_state_out" | sed -n 's/^Puppet state written to //p')
        if [[ -n "$_state_file" ]]; then
            echo "  state: ${_state_file}"
        else
            echo "$_state_out" | sed 's/^/  /'
        fi
    else
        echo "  WARNING: write_puppet_state function not available, skipping state file write" >&2
    fi
    # ==============================================================================

    case $retval in
        0|2)
            return 0
            ;;
        *)
            email_report "Puppet apply failed on ${FQDN}" "${LOG_OUT}"
            return 1
            ;;
    esac
}


# Main script starts here

# Color helpers — only when stdout is a TTY (suppresses codes in journal/pipes)
if [ -t 1 ]; then
    _BOLD="\033[1m"; _DIM="\033[2m"; _GREEN="\033[32m"; _RED="\033[31m"; _YELLOW="\033[33m"; _CYAN="\033[36m"; _RESET="\033[0m"
else
    _BOLD=""; _DIM=""; _GREEN=""; _RED=""; _YELLOW=""; _CYAN=""; _RESET=""
fi

WRITE_SENTINEL=1
while [[ $# -gt 0 ]]; do
    case $1 in
        -n|--no-sentinel) WRITE_SENTINEL=0 ;;
    esac
    shift
done

# Ensure we are running as root
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root (current user: $(id -un))." >&2
    exit 1
fi

PUPPET_REPO="${PUPPET_REPO:-<%= @puppet_repo -%>}"
PUPPET_BRANCH="${PUPPET_BRANCH:-<%= @puppet_branch -%>}"
PUPPET_MAIL="${PUPPET_MAIL:-<%= @puppet_notify_email %>}"

# detect if python3 is available and set it to PYTHON_BIN
if command -v python3 &> /dev/null; then
    PYTHON_BIN=$(command -v python3)
else
    PYTHON_BIN=$(command -v python)
fi

# check if yq is installed
if command -v yq-er &> /dev/null; then
    YQ_PRESENT=1
    YQ_BIN=$(command -v yq-er)
else
    YQ_PRESENT=0
    YQ_BIN=""
    # echo "yq command not found"
fi

# show header (send to stderr to avoid appearing in log output?)
# pyfiglet font is cricket
[ -t 2 ] && printf '\033[2m' >&2
cat <<'EOF' >&2
                                                         __
  .----.--.--.-----.______.-----.--.--.-----.-----.-----|  |_
  |   _|  |  |     |______|  _  |  |  |  _  |  _  |  -__|   _|
  |__| |_____|__|__|      |   __|_____|   __|   __|_____|____|
                          |__|        |__|  |__|
EOF
[ -t 2 ] && printf '\033[0m' >&2

# Override defaults with values from /etc/puppet/ronin_settings if the file exists
if [ -f "/etc/puppet/ronin_settings" ]; then
    # ascii art heredoc
    cat <<'EOF' >&2
                                     __    __
        .-----.--.--.-----.----.----|__.--|  .-----.
        |  _  |  |  |  -__|   _|   _|  |  _  |  -__|
        |_____|\___/|_____|__| |__| |__|_____|_____|

EOF
    echo "Loading settings from /etc/puppet/ronin_settings..."
    source /etc/puppet/ronin_settings
    # show env vars of interest
    echo -e "  PUPPET_BRANCH:         ${_DIM}$PUPPET_BRANCH${_RESET}"
    echo -e "  PUPPET_REPO:           ${_DIM}$PUPPET_REPO${_RESET}"
    echo -e "  PUPPET_MAIL:           ${_DIM}$PUPPET_MAIL${_RESET}"
    if [ -n "${WORKER_TYPE_OVERRIDE}" ]; then
        echo -e "  WORKER_TYPE_OVERRIDE:  ${_YELLOW}${WORKER_TYPE_OVERRIDE}${_RESET}"
    else
        echo -e "  WORKER_TYPE_OVERRIDE:  ${_DIM}${WORKER_TYPE_OVERRIDE}${_RESET}"
    fi
fi

ROLE_FILE='/etc/puppet_role'
PUPPET_BIN='/opt/puppetlabs/bin/puppet'
FACTER_BIN='/opt/puppetlabs/bin/facter'
GITHUB_KNOWN_HOSTS_PATH='/root/.ssh/known_hosts'
FQDN=$(${FACTER_BIN} networking.fqdn)

select_puppet_repository_profile \
  || fail "PUPPET_REPO is not an allowlisted repository"

export LANG=en_US.UTF-8

# Create the root-owned checkout directory. Do not repair an existing unsafe
# checkout in place: it may already contain attacker-controlled Git metadata.
if [ ! -e "${WORKING_DIR}" ] && [ ! -L "${WORKING_DIR}" ]; then
    install -d -o root -g root -m 0755 "${WORKING_DIR}" || fail
fi
require_secure_working_dir
cd "${WORKING_DIR}" || fail

# Set role or fail if file not found
if [ -f "${ROLE_FILE}" ]; then
    ROLE=$(<${ROLE_FILE})
else
    fail "Failed to find puppet role file ${ROLE_FILE}"
fi

[ -f '/root/vault.yaml' ] || fail "Secrets file not found"

echo ""
echo -e "ROLE: ${_CYAN}${ROLE}${_RESET}"
echo ""

function show_previous_run_status {
    local metadata_file="/etc/puppet/last_run_metadata.json"
    echo "Previous run:"
    if [ ! -f "$metadata_file" ]; then
        echo "  (no metadata file found — first run or file missing)"
        return
    fi
    $PYTHON_BIN - "$metadata_file" <<'PYEOF'
import json, sys
from datetime import datetime, timezone

try:
    with open(sys.argv[1]) as f:
        m = json.load(f)
    success   = m.get("success", False)
    exit_code = m.get("exit_code", "?")
    duration  = m.get("duration_s", "?")
    ts        = m.get("ts", "")
    git_sha   = (m.get("git_sha") or "?")[:8]

    age_str = ts
    if ts:
        try:
            dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
            age_s = (datetime.now(timezone.utc) - dt).total_seconds()
            if age_s < 3600:
                age_str = f"{int(age_s / 60)}m ago"
            elif age_s < 86400:
                age_str = f"{age_s / 3600:.1f}h ago"
            else:
                age_str = f"{age_s / 86400:.1f}d ago"
        except Exception:
            pass

    if sys.stdout.isatty():
        GREEN, RED, RESET = "\033[32m", "\033[31m", "\033[0m"
    else:
        GREEN = RED = RESET = ""
    status_str = f"{GREEN}PASSED{RESET}" if success else f"{RED}FAILED (exit {exit_code}){RESET}"
    print(f"  status:   {status_str}")
    print(f"  when:     {age_str}  ({ts})")
    print(f"  duration: {duration}s")
    print(f"  git sha:  {git_sha}")
except Exception as e:
    print(f"  (could not parse metadata: {e})")
PYEOF
}

lifecycle_log observe-boot
lifecycle_log emit puppet_run_started

show_previous_run_status
echo ""

# GitHub authentication setup
require_secure_working_dir
configure_git_auth || fail "Failed to configure Git authentication"

# block_on_network

# Normal boot/worker execution retries until Puppet converges. Fleetroll
# requests a bounded operator action by setting FLEETROLL_SINGLE_RUN=1.
while ! run_puppet; do
    if [ "${FLEETROLL_SINGLE_RUN:-0}" = "1" ]; then
        echo -e "${_RED}Puppet run failed; exiting after one Fleetroll-requested attempt${_RESET}"
        exit 1
    fi
    echo -e "${_RED}Puppet run failed; re-trying after 10m${_RESET}"
    sleep 600
    # A public HTTPS fallback applies only to one fetch attempt. Re-select
    # credentials before retrying so the preferred method is tried again.
    configure_git_auth || fail "Failed to configure Git authentication"
done

# Touch the semaphore to allow launchd to start generic worker (if applicable)
# mkdir -p "/var/tmp/semaphore"
# chmod 0777 "/var/tmp/semaphore"
# touch "/var/tmp/semaphore/run-buildbot"

# override worker type with value defined in /etc/puppet/ronin_settings
if [ -n "$WORKER_TYPE_OVERRIDE" ]; then
    echo -e "${_YELLOW}[WARN] Worker type override from /etc/puppet/ronin_settings${_RESET}"
    echo "  WORKER_TYPE_OVERRIDE: $WORKER_TYPE_OVERRIDE"

    # rewrite the config
    /usr/local/bin/change_workertype.py -t "${WORKER_TYPE_OVERRIDE}"
fi

# touch the semaphore to let run-start-worker know it can start start-worker
lifecycle_log emit puppet_run_succeeded
if [ "$WRITE_SENTINEL" -eq 1 ]; then
    /usr/local/bin/puppet-run-marker publish || fail "Failed to publish Puppet completion marker"
else
    echo "Skipping sentinel (--no-sentinel)"
fi

exit 0
