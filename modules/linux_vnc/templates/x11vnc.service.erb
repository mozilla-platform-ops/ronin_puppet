#
# Define x11vnc service

[Unit]
Description=Manually start x11vnc server attached to <%= @user %> X session
After=Xsession.service

[Service]
TimeoutSec=5min
IgnoreSIGPIPE=no
KillMode=process
GuessMainPID=no
# Root prepares the password outside the task-owned home. The VNC group can
# read it, but cannot replace it. Systemd removes the directory on stop/failure.
User=root
Group=<%= @group %>
RuntimeDirectory=x11vnc
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=no
ExecStartPre=/usr/bin/install -o root -g <%= @group %> -m 0640 /etc/vnc_passwdfile /run/x11vnc/passwdfile
ExecStart=/bin/su - -c "/usr/bin/x11vnc -display WAIT:0 -passwdfile /run/x11vnc/passwdfile -forever -shared" <%= @user %>

[Install]
WantedBy=multi-user.target
