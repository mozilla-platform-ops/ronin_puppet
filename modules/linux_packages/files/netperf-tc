#!/usr/bin/python3 -I
"""Apply netperf traffic shaping on loopback.

Usage:
  netperf-tc check
  netperf-tc reset
  netperf-tc apply BANDWIDTH_MBIT DELAY_MS LOSS tcp|udp PORT

DELAY_MS is the one-way netem delay. LOSS is a percentage from 0 to 100.
"""

import os
import re
import subprocess
import sys
from decimal import Decimal, InvalidOperation, ROUND_UP


TC = "/sbin/tc"
# Percentages from 0 through 100; 100 may have only a zero-valued fraction.
LOSS_RE = re.compile(r"(?:0|[1-9][0-9]?)(?:\.[0-9]+)?|100(?:\.0+)?")
# Decimal ports from 1 through 99,999; the 65,535 ceiling is checked below.
PORT_RE = re.compile(r"[1-9][0-9]{0,4}")
# Non-negative decimal values up to 1,000,000 with at most three decimal places.
NUMBER_RE = re.compile(r"(?:0|[1-9][0-9]{0,6})(?:\.[0-9]{1,3})?")
PROTOCOLS = {"tcp": "6", "udp": "17"}
MAX_BANDWIDTH_MBIT = Decimal("10000")
MAX_DELAY_MS = Decimal("60000")
MAX_NETEM_LIMIT = 10_000_000


def usage():
    print("Usage: netperf-tc check | reset | apply BANDWIDTH_MBIT DELAY_MS LOSS PROTOCOL PORT", file=sys.stderr)
    return 2


def tc(*args):
    subprocess.run([TC, *args], check=True)


def reset():
    subprocess.run(
        [TC, "qdisc", "del", "dev", "lo", "root"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def parse_number(value, maximum, allow_zero):
    if not NUMBER_RE.fullmatch(value):
        return None
    try:
        number = Decimal(value)
    except InvalidOperation:
        return None
    if number > maximum or (not allow_zero and number == 0):
        return None
    return number


def apply(bandwidth_mbit, delay_ms, loss, protocol_name, port):
    bandwidth = parse_number(bandwidth_mbit, MAX_BANDWIDTH_MBIT, allow_zero=False)
    delay = parse_number(delay_ms, MAX_DELAY_MS, allow_zero=True)
    if bandwidth is None or delay is None:
        return usage()
    if not LOSS_RE.fullmatch(loss):
        return usage()
    if protocol_name not in PROTOCOLS:
        return usage()
    if not PORT_RE.fullmatch(port) or int(port) > 65535:
        return usage()

    protocol = PROTOCOLS[protocol_name]
    bdp = int((bandwidth * 1000 * delay * 2 / 8).to_integral_value(rounding=ROUND_UP))
    bdp = min(max(bdp, 1500), MAX_NETEM_LIMIT)
    reset()
    tc("qdisc", "add", "dev", "lo", "root", "handle", "1:", "htb", "default", "12")
    tc("class", "add", "dev", "lo", "parent", "1:", "classid", "1:1", "htb", "rate", f"{bandwidth}Mbit")
    netem_args = ["qdisc", "add", "dev", "lo", "parent", "1:1", "handle", "10:", "netem", "delay", f"{delay}ms"]
    if not re.fullmatch(r"0(?:\.0+)?", loss):
        netem_args.extend(["loss", f"{loss}%"])
    tc(*netem_args, "limit", str(bdp))
    for family, match in (("ip", "ip"), ("ipv6", "ip6")):
        for direction in ("dport", "sport"):
            tc(
                "filter", "add", "dev", "lo", "protocol", family,
                "parent", "1:0", "u32", "match", match, "protocol",
                protocol, "0xff", "match", match, direction, port, "0xffff",
                "flowid", "1:1",
            )
    return 0


def main(argv):
    if argv == ["check"]:
        return 0 if os.access(TC, os.X_OK) else 1
    if argv == ["reset"]:
        reset()
        return 0
    if len(argv) == 6 and argv[0] == "apply":
        return apply(*argv[1:])
    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
