provider:
    providerType: <%= $win_taskcluster::worker_runner::provider %>
worker:
    implementation: <%= $win_taskcluster::worker_runner::implementation %>
    path: <%= $win_taskcluster::worker_runner::gw_exe_path %>
    protocolPipe: \\.\pipe\generic-worker
    configPath: <%= $win_taskcluster::worker_runner::config_file %>
cacheOverRestarts: true
<% if $win_taskcluster::generic_worker::source_build or $win_taskcluster::worker_runner::task_drive { -%>
workerConfig:
<% if $win_taskcluster::worker_runner::task_drive { -%>
    tasksDir: '<%= $win_taskcluster::worker_runner::task_drive %>\tasks'
    cachesDir: '<%= $win_taskcluster::worker_runner::task_drive %>\caches'
    downloadsDir: '<%= $win_taskcluster::worker_runner::task_drive %>\downloads'
<% } -%>
<% if $win_taskcluster::generic_worker::source_build { -%>
    preloadedDirectoryCaches:
        - cacheName: relops-8809-smoke-20260918
          location: 'C:\cache-seeds\relops-8809-smoke-20260918'
        - cacheName: gecko-level-1-checkouts
          location: 'C:\cache-seeds\gecko'
        - cacheName: gecko-level-1-pip
          location: 'C:\cache-seeds\pip'
<% } -%>
<% } -%>
