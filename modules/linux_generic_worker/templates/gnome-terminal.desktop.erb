[Desktop Entry]
Type=Application
<% if @desktop_start_in_terminal -%>
Exec=gnome-terminal -- <%= @desktop_start_command %>
<% else -%>
Exec=<%= @desktop_start_command %>
Path=<%= @user_homedir %>
<% end -%>
Hidden=false
X-GNOME-Autostart-enabled=true
Name=Generic-Worker
Comment=Start generic-worker
StartupNotify=false
Terminal=false
