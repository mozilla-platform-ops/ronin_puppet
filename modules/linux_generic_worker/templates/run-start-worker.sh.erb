#!/usr/bin/env bash

set -e
set -x

# Run one task per boot. v115+ runs generic-worker directly; older versions use
# start-worker. This wrapper handles holds, lifecycle logging and reboots.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin

# hold: don't do anything (tests or reboots)
# - never cleared automatically
# - only created manually
hold_semaphore_file='<%= @user_homedir %>/operator_hold'

# Lifecycle logging is observational only: no failure may interrupt the worker.
function lifecycle_log {
    if [ ! -x /usr/local/bin/lifecycle-log ]; then
        return 0
    fi
    if [ "$1" = 'import-generic-worker' ]; then
        if ! /usr/bin/sudo /usr/local/bin/lifecycle-log "$@"; then
            echo "lifecycle-log $* failed; continuing without lifecycle event" >&2
        fi
    elif ! /usr/local/bin/lifecycle-log "$@"; then
        echo "lifecycle-log $* failed; continuing without lifecycle event" >&2
    fi
}

# if the  host is in hold mode, don't start until cleared
if [ -f "$hold_semaphore_file" ]; then
    echo "Worker is in operator hold mode. Waiting to start..."
    while [ -f "$hold_semaphore_file" ]; do
        sleep 15
    done
    echo "Operator hold mode cleared. Starting..."
fi

# wait for puppet to finish before starting
# - we want a quiet system for perf tests
# - created by run-puppet.sh
if ! /usr/local/bin/puppet-run-marker check; then
    echo -n "Waiting for puppet to finish... "
    while ! /usr/local/bin/puppet-run-marker check; do
        sleep 5
        echo -n '.'
    done
    echo " done."
fi

# Run from the worker home: cache indexes and task counters are relative to it.
cd '<%= @user_homedir %>'
rm -f tasks-resolved-count.txt

lifecycle_log emit worker_started
<% if @generic_worker_115_or_newer -%>
/usr/local/bin/generic-worker run --config '<%= @user_homedir %>/generic-worker.config' 2>&1 | logger -t generic-worker
<% else -%>
/usr/local/bin/start-worker "$@" 2>&1 | logger -t generic-worker
<% end -%>

exitstatus="${PIPESTATUS[0]}"

lifecycle_log import-generic-worker
lifecycle_log emit worker_exited --exit-code "$exitstatus"

# if the  host is in hold mode, exit now
if [ -f "$hold_semaphore_file" ]; then
    echo "Worker is in operator hold mode. Exiting..."
    exit 0
fi

if [ $exitstatus -eq 69 ]; then
    # Exit without rebooting or starting another task. This needs operator
    # investigation; the retired check_gw timer must not restart the host.
    echo 'worker exited 69; worker stopped for investigation' >&2
    exit 69
else
    # Now reboot the machine immediately (time costs money)
    lifecycle_log emit restart_executed --trigger post_task
    <%= @reboot_command %>
    # Sleep to prevent this script from terminating naturally, and launchd restarting
    # it. Instead, the shutdown should cause this script to terminate (so it won't
    # really sleep for 2 mins). If shutdown doesn't kick in within 2 mins, it is sane
    # for this script to exit, and allow launchd to fire up the worker again.
    /bin/sleep 120
fi
