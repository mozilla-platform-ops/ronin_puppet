def run_checks():
    results = []
    for name, fn in CHECKS:
        try:
            status, detail, data = fn()
        except Exception as e:
            status, detail, data = FAIL, f"check raised exception: {e}", {}
        check_cmds = data.pop("check_cmds", [])
        equiv_cmds = data.pop("equiv_cmds", [])
        results.append({"name": name, "status": status, "detail": detail, "data": data, "check_commands": check_cmds, "check_command_equivalents": equiv_cmds})
    return results


def overall(results):
    return FAIL if any(r["status"] == FAIL for r in results) else PASS


def _by_name(results, name):
    for r in results:
        if r["name"] == name:
            return r
    return None


def summarize(results):
    puppet = _by_name(results, "puppet") or {}
    gwp    = _by_name(results, "generic_worker_process") or {}
    pdata  = puppet.get("data", {})
    gdata  = gwp.get("data", {})

    if gdata.get("zombie_pids"):
        state = "DOWN" if puppet.get("status") == FAIL else "DEGRADED"
        return state, gwp.get("detail", "zombie generic-worker")

    failures = [r for r in results if r["status"] == FAIL]
    if failures:
        state = "DOWN" if puppet.get("status") == FAIL else "DEGRADED"
        return state, "; ".join(f"{r['name']}: {r['detail']}" for r in failures)

    disk = _by_name(results, "disk_free") or {}
    if (disk.get("data") or {}).get("cleaner_running"):
        cpid = (disk.get("data") or {}).get("cleaner_pid")
        pid_str = f" (pid {cpid})" if cpid else ""
        return "RECOVERING", f"disk cleanup running{pid_str}, wait for completion"

    puppet_in_progress = (
        pdata.get("done_sentinel") is False
        or pdata.get("service_active_state") == "activating"
        or "retrying" in puppet.get("detail", "")
        or "not yet run this boot" in puppet.get("detail", "")
    )
    if puppet_in_progress:
        if not gdata.get("generic_worker_pids"):
            return "PROVISIONING", "puppet running, g-w waiting to start"
        return "PROVISIONING", "puppet running, g-w up"

    if gdata.get("task_state") == "task running":
        n = gdata.get("child_procs", "?")
        load1 = (gdata.get("load_avg") or {}).get("1m", "?")
        return "WORKING", f"g-w running task ({n} children, load {load1})"

    ts = gdata.get("task_state", "unknown")
    if ts == "idle":
        return "IDLE", "g-w waiting for tasks"
    return "UNKNOWN", f"g-w task activity unknown ({ts}); verify activity before rebooting"


_STATE_COLOR = {
    "RECOVERING":   yellow,
    "PROVISIONING": yellow,
    "WORKING":      green,
    "IDLE":         green,
    "UNKNOWN":      yellow,
    "DEGRADED":     yellow,
    "DOWN":         red,
}


DISPLAY_NAMES = {
    "clock_skew": "clock",
    "disk_free": "disk",
    "task_dir_size": "task directory",
    "puppet": "puppet",
    "worker_runner_process": "worker runner",
    "generic_worker_process": "generic worker",
}


def _relative_age(hours):
    minutes = max(0, int(hours * 60))
    if minutes < 1:
        return "less than a minute ago"
    if minutes < 60:
        return f"{minutes} minute{'s' if minutes != 1 else ''} ago"
    if hours < 24:
        count = int(hours)
        return f"{count} hour{'s' if count != 1 else ''} ago"
    count = int(hours / 24)
    return f"{count} day{'s' if count != 1 else ''} ago"


def _format_detail(result):
    detail = result["detail"]
    if result["name"] == "puppet":
        detail = re.sub(r" \(role=[^)]*\)", "", detail)
        # Older replay snapshots use decimal hours in their detail text.
        detail = re.sub(r"(\d+(?:\.\d+)?)h ago", lambda m: _relative_age(float(m.group(1))), detail)
    if result["name"] == "generic_worker_process" and result.get("data", {}).get("task_state") == "task running":
        detail = re.sub(r", do not reboot$", "", detail)
    return detail


def print_json(results, warnings, verbose=False, debug=False):
    check_warns = [f"{r['name']}: {r['detail']}" for r in results if r["status"] == WARN]
    state, state_description = summarize(results)
    checks = [
        {k: v for k, v in r.items() if k not in ("check_commands", "check_command_equivalents")} for r in results
    ]
    for check, result in zip(checks, results):
        if verbose or debug:
            check["troubleshooting_commands"] = [
                {"label": label, "command": cmd}
                for label, cmd in TROUBLESHOOTING_COMMANDS.get(result["name"], [])
            ]
        if debug:
            for key in ("check_commands", "check_command_equivalents"):
                check[key] = result.get(key, [])
    out = {
        "ok": overall(results) == PASS,
        "state": state,
        "state_description": state_description,
        "host": socket.gethostname(),
        "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "warnings": warnings + check_warns,
        "checks": checks,
    }
    print(json.dumps(out, indent=2))


def print_human(results, warnings, verbose=False, debug=False):
    for w in warnings:
        print(yellow(f"WARNING: {w}"), file=sys.stderr)

    state, qualifier = summarize(results)
    ov = overall(results)
    color = _STATE_COLOR.get(state, lambda s: s)
    print(f"{bold(color(state))} — {qualifier}")

    pdata = (_by_name(results, "puppet") or {}).get("data") or {}
    role_label = "Role" if pdata.get("configured_role") else "Role (last run)"
    role = pdata.get('configured_role') or pdata.get('role') or 'unknown'
    print(f"{role_label}: {role} | Worker type (configured): {pdata.get('worker_type') or 'unknown'}")
    branch = pdata.get("git_branch") or "unknown"
    sha = pdata.get("git_sha") or "unknown"
    branch_text = purple(branch) if branch not in ("master", "unknown") else branch
    print(f"Last Puppet run: {branch_text} @ {dim(sha[:8] if sha != 'unknown' else sha)}")
    if verbose or debug:
        print(dim(f"Full SHA: {sha}"))
    if state == "WORKING":
        print("Task active — wait for completion before rebooting.")

    if ov == FAIL:
        if state == "RECOVERING":
            disk_r = _by_name(results, "disk_free") or {}
            cpid = (disk_r.get("data") or {}).get("cleaner_pid")
            pid_str = f" (pid {cpid})" if cpid else ""
            print(f"  → cleanup in progress{pid_str} — wait for it to finish")
        elif state == "PROVISIONING":
            print(f"  → puppet has not finished yet — worker will start once it completes")
        else:
            first_fail = next(r for r in results if r["status"] == FAIL)
            print(f"  → most likely cause: {red(first_fail['name'])} — {first_fail['detail']}")

    w = max(len(DISPLAY_NAMES.get(r["name"], r["name"])) for r in results)
    indent = " " * (2 + 1 + 2 + w + 2)  # marker + spacing + name col + spacing
    for r in results:
        s = r["status"]
        if s == PASS:
            marker = green("✓")
        elif s == WARN:
            marker = yellow("⚠")
        else:
            marker = red("✗")
        name = DISPLAY_NAMES.get(r["name"], r["name"])
        print(f"  {marker}  {name.ljust(w)}  {_format_detail(r)}")
        if s == FAIL:
            hint = REMEDIATIONS.get(r["name"])
            if hint:
                for line in hint.splitlines():
                    print(f"{indent}{yellow('→')} {line}")
        if verbose or debug:
            for label, cmd in TROUBLESHOOTING_COMMANDS.get(r["name"], []):
                print(dim(f"{indent}{label}: {cmd}"))
        if debug:
            for cmd in r.get("check_commands") or []:
                print(dim(f"{indent}Check command: {cmd}"))
            for cmd in r.get("check_command_equivalents") or []:
                print(dim(f"{indent}Equivalent command: {cmd}"))


def main():
    parser = argparse.ArgumentParser(
        description="Read-only health check for Linux Taskcluster generic-worker hosts.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Exit 0 if all checks pass or warn. Exit 1 if any check fails.",
    )
    parser.add_argument("-j", "--json", action="store_true", help="emit JSON report to stdout")
    parser.add_argument("-v", "--verbose", action="store_true", help="show labeled troubleshooting commands for each check")
    parser.add_argument("--debug", action="store_true", help="also show commands used internally by checks (includes --verbose)")

    testing = parser.add_argument_group("testing arguments")
    testing.add_argument(
        "--replay", metavar="PATH",
        help="read a prior --json snapshot (or '-' for stdin) and re-render without running checks",
    )
    args = parser.parse_args()

    warnings = []
    if args.replay:
        src = sys.stdin if args.replay == "-" else open(args.replay)
        with src as f:
            snapshot = json.load(f)
        results = snapshot["checks"]
        warnings = snapshot.get("warnings", [])
    else:
        if os.geteuid() != 0:
            warnings.append("not running as root — journalctl checks will return 'unknown' (run with sudo)")
        results = run_checks()
    if args.json:
        print_json(results, warnings, verbose=args.verbose, debug=args.debug)
    else:
        print_human(results, warnings, verbose=args.verbose, debug=args.debug)
    sys.exit(0 if overall(results) == PASS else 1)


if __name__ == "__main__":
    main()
