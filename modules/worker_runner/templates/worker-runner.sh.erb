#!/bin/bash

export PATH=/usr/local/bin:/bin:/sbin:/usr/bin:/usr/sbin

last_premature_end=<%= @data_dir %>/worker_running_semaphore
if test $(find $last_premature_end -mmin -2); then
    echo "Last worker-runner.sh execution started less than 120s ago. Sleeping 30s ..."
    sleep 30
fi
date > $last_premature_end

# This is a wrapper script for calling worker runner, such that when the worker
# exits, this script will reboot the machine.

# TODO: Add only find and delete orpan files if running in multiuser mode
#(find /private/var/folders/ -nouser -delete; echo "Finished clearing old cache files" ) &

# Removing the tasks-resolved-count.txt allows the worker to exit properly when numberOfTasksToRun is reached
if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    rm -f <%= @gw_root_dir %>/tasks-resolved-count.txt
else
    rm -f <%= @data_dir %>/tasks-resolved-count.txt
fi

# Clear up previous task dirs
if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    rm -rf <%= @task_dir %>/<%= @task_user %>
else
    rm -rf <%= @task_dir %>/task_*
fi

# generic-worker's file cache (downloadsDir plus its file-caches.json index) is
# not bounded: it gains an entry and a file per task artifact fetched, and nothing
# prunes either. The worker revalidates the whole index on every start, between
# its "Loaded file file-caches.json" and "All features initialised" log lines, so
# on hosts that reboot between tasks that cost is paid per task.
#
# Measured on gecko-t-osx-1015-r8 (2026-08-05): macmini-r8-181 had 21289 index
# entries and 21292 files (29 GB) in downloads, and spent ~11 minutes there;
# macmini-r8-208, with 3 entries and 3 files, spent under 2 seconds. Clearing the
# index on r8-181 took its next startup to 2 seconds.
#
# The index and the files must be cleared together. Removing only the index
# strands the downloads: the worker cannot evict files it no longer has a record
# of, and 29 GB was orphaned on r8-181 doing exactly that. Note this is the file
# cache only -- the named directory caches (pip/uv, ~65 GB) are tracked
# separately in directory-caches.json and are deliberately left alone.
#
# Done here rather than in macos_directory_cleaner's clean_before_reboot.sh so the
# ordering relative to the start-worker call below is deterministic; both would
# otherwise run at boot, and org.mozilla.cleanbeforereboot was observed not loaded
# on at least one host.
#
# find -delete rather than rm -rf on a glob: the directory routinely holds 16k-21k
# entries, which risks ARG_MAX ("Argument list too long") when expanded onto a
# single command line. find has no such limit. Verified as the task user (cltbld,
# who owns the 0700 directory) on r8-70 and r8-181: cleared 16080 and 21292 files
# respectively, 29 GB in 21s on r8-181.
if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    rm -f <%= @gw_root_dir %>/file-caches.json
else
    rm -f <%= @data_dir %>/file-caches.json
fi
find <%= @data_dir %>/downloads -mindepth 1 -delete

# https://bugzilla.mozilla.org/show_bug.cgi?id=1927416
# find /private/var/folders/ -depth -path '*/C/org.mozilla.*' -type d -exec rm -rf {} +

# https://bugzilla.mozilla.org/show_bug.cgi?id=1967525
if [ -x  /usr/local/bin/lsdb.py ]; then
    python3 /usr/local/bin/lsdb.py --delete-stale
else
    echo "lsdb.py not found, skipping launch services cleanup."
fi

if [ -x /usr/local/bin/run-puppet.sh ]; then
    sudo /usr/local/bin/run-puppet.sh
else
    echo "run-puppet.sh not found, skipping Puppet run."
fi

if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    # Run worker from <%= @gw_root_dir %> when in multiuser-static mode
    cd <%= @gw_root_dir %>
fi

# First run worker runner, passing through any arguments handed to this
# wrapper script...
/usr/local/bin/start-worker "$@"

exitstatus="${PIPESTATUS[0]}"

# TODO: add logic to remove sempaphore only if puppet is running atboot
# Remove semaphore file to ensure worker runner does not start before puppet
# rm -f "/var/tmp/semaphore/run-buildbot"

# If generic-worker considers that the host environment is in an invalid/corrupted
# state (for example, it cannot write to disk), it will return the exit code 69.
#
# More information about generic-worker exit codes can be seen here:
# https://docs.taskcluster.net/docs/reference/workers/generic-worker#set-up-your-env
last_failed_semaphore=<%= @data_dir %>/worker_exit_69
if [ $exitstatus -eq 69 ]; then
    if [ -f $last_failed_semaphore ]; then
        if [[ $(find "$last_failed_semaphore" -mmin +15 -print) ]]; then
            echo "Problem repeated for 15m. Sleep 10m ..."
            sleep 600
        else
            echo "Worker repeat exit code 69. Sleep 120s ..."
            sleep 120
        fi
    else
        echo "Exit code 69. Sleep 60s ..."
        printf "$(date) ${exitstatus}" > $last_failed_semaphore
        sleep 60
    fi
elif [ $exitstatus -gt 69 -o $exitstatus -lt 69 ]; then
    if [ -f $last_failed_semaphore ]; then
        echo "Worker recovered from previous exit code 69."
        cat $last_failed_semaphore
        rm -f $last_failed_semaphore
    fi
fi

if test $(find $last_premature_end -mmin +1); then
    rm -f $last_premature_end
else
    echo "Started less than 60s ago. Sleeping 30s"
    sleep 30
fi

echo "REBOOT $(date)"
/usr/bin/sudo /sbin/reboot
# Sleep to prevent this script from terminating naturally, and launchd restarting
# it. Instead, the shutdown should cause this script to terminate (so it won't
# really sleep for 2 mins). If shutdown doesn't kick in within 2 mins, it is sane
# for this script to exit, and allow launchd to fire up the worker again.
sleep 120
