#!/bin/bash

export PATH=/usr/local/bin:/bin:/sbin:/usr/bin:/usr/sbin

last_premature_end=<%= @data_dir %>/worker_running_semaphore
if test $(find $last_premature_end -mmin -2); then
    echo "Last worker-runner.sh execution started less than 120s ago. Sleeping 30s ..."
    sleep 30
fi
date > $last_premature_end

# This is a wrapper script for calling worker runner, such that when the worker
# exits, this script will reboot the machine.
<% if @skip_reboot_between_tasks -%>
#
# skip_reboot_between_tasks: instead of rebooting after every task, loop back
# and run the same pre-task cleanup again. The reboot used to clear two things
# no script did -- processes the task left running and the task's temp files --
# so those are handled after each task below. Any cycle that is not a clean
# success (failed task, non-zero worker exit, unkillable leftover process) or
# that reaches <%= @max_tasks_between_reboots %> tasks still reboots.
#
# State lives in this shell, not in files the task user could edit, so it
# resets with the reboot that ends the loop.
tasks_since_boot=0
iteration_marker=<%= @data_dir %>/iteration_started
proc_list=<%= @data_dir %>/task_user_processes
baseline_procs=""

# "pid comm" for every <%= @task_user %> process. Read from a file, not a
# pipe, so the loop runs in this shell and the listing sees no subshell of ours.
list_task_processes() {
    ps -U <%= @task_user %> -o pid=,ppid=,comm= | sed -E 's/^ +//' > "$proc_list"
}

# Sets $strays to <%= @task_user %> processes that were not running before the
# first task of this boot. Apple's own launchd services and generic-worker's
# launch agent are left alone; launchd owns their lifecycle.
find_strays() {
    local pid ppid comm
    strays=""
    list_task_processes
    while read -r pid ppid comm; do
        [ -n "$pid" ] || continue
        [ "$pid" = "$$" ] && continue
        [ "$ppid" = "$$" ] && continue
        case "$comm" in
            /System/*|/usr/libexec/*|/usr/sbin/*|/sbin/*|/Library/Apple/*|/usr/local/bin/generic-worker*) continue ;;
        esac
        printf '%s\n' "$baseline_procs" | grep -qxF "$pid $comm" && continue
        strays="${strays}${pid} ${comm}"$'\n'
    done < "$proc_list"
}

reap_strays() {
    local sig
    for sig in TERM KILL; do
        find_strays
        [ -z "$strays" ] && return 0
        echo "Sending SIG${sig} to leftover <%= @task_user %> processes:"
        printf '%s' "$strays"
        printf '%s' "$strays" | awk '{print $1}' | xargs kill -"$sig" 2>/dev/null
        sleep 3
    done
    find_strays
    [ -z "$strays" ]
}

# Remove what the task left in the task user's temp dirs. Only entries changed
# since the task started are touched, and com.apple.* / TemporaryItems are
# skipped, because the login session's own agents keep state there.
clean_task_temp() {
    local tmpdir
<% if @generic_worker_engine == 'multiuser-static' -%>
    tmpdir=$(/usr/bin/sudo -u <%= @task_user %> /usr/bin/getconf DARWIN_USER_TEMP_DIR 2>/dev/null)
<% else -%>
    tmpdir=$(/usr/bin/getconf DARWIN_USER_TEMP_DIR 2>/dev/null)
<% end -%>
    tmpdir=${tmpdir%/}
    if [ -n "$tmpdir" ] && [ -d "$tmpdir" ] && [ ! -L "$tmpdir" ]; then
        find "$tmpdir" -mindepth 1 -maxdepth 1 -newer "$iteration_marker" \
            ! -name 'com.apple.*' ! -name 'TemporaryItems' -exec rm -rf {} + 2>/dev/null
    fi
    find /private/tmp -mindepth 1 -maxdepth 1 -user <%= @task_user %> -newer "$iteration_marker" \
        ! -name 'com.apple.*' -exec rm -rf {} + 2>/dev/null
}

# The loop body below is deliberately not re-indented, so that roles without
# skip_reboot_between_tasks render this script unchanged.
while true; do
date > $last_premature_end
<% end -%>

# TODO: Add only find and delete orpan files if running in multiuser mode
#(find /private/var/folders/ -nouser -delete; echo "Finished clearing old cache files" ) &

# Removing the tasks-resolved-count.txt allows the worker to exit properly when numberOfTasksToRun is reached
if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    rm -f <%= @gw_root_dir %>/tasks-resolved-count.txt
else
    rm -f <%= @data_dir %>/tasks-resolved-count.txt
fi

# Clear up previous task dirs
if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    rm -rf <%= @task_dir %>/<%= @task_user %>
else
    rm -rf <%= @task_dir %>/task_*
fi

# generic-worker's file cache (downloadsDir plus its file-caches.json index) is
# not bounded: it gains an entry and a file per task artifact fetched, and nothing
# prunes either. The worker revalidates the whole index on every start, between
# its "Loaded file file-caches.json" and "All features initialised" log lines, so
# on hosts that reboot between tasks that cost is paid per task.
#
# Observed on gecko-t-osx-1015-r8 (2026-08-05): r8-147 held 20495 files / 20479
# index entries, r8-226 17203 / 17188, r8-181 21292 / 29 GB. Startup stalled for
# 294-396s on 14 of 15 boots on r8-147 and 524-585s on 9 of 15 on r8-226, against
# under 2s on r8-208 which had 3 of each. After purging, both hosts start with no
# index to load at all and reclaimed 31 GB and 27 GB respectively.
#
# The index and the files must be cleared together. Removing only the index
# strands the downloads -- the worker cannot evict files it has no record of -- and
# 29 GB was orphaned on r8-181 doing exactly that. This is the file cache only:
# the named directory caches (pip/uv, ~65 GB) are tracked separately in
# directory-caches.json and are deliberately left alone.
#
# Done here rather than in macos_directory_cleaner's clean_before_reboot.sh so the
# ordering relative to the start-worker call below is deterministic; both would
# otherwise run at boot, and org.mozilla.cleanbeforereboot was observed not loaded
# on at least one host.
#
# The delete is detached, and the directory is renamed out of the way first, so
# worker startup never waits on it. That matters for the first purge on a host that
# has already accumulated: clearing ~20k files inline took 15 minutes on r8-147 and
# 2.5 minutes on r8-226, and the worker had not started during that time. A rename
# is O(1) regardless of how much has piled up. In steady state only a handful of
# files accumulate per task, so there is normally nothing to do. Renaming rather
# than globbing also avoids ARG_MAX on the accumulated case.
if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    rm -f <%= @gw_root_dir %>/file-caches.json
else
    rm -f <%= @data_dir %>/file-caches.json
fi
gw_downloads=<%= @data_dir %>/downloads
if [ -d "$gw_downloads" ]; then
    gw_purge="${gw_downloads}.purging.$$"
    if mv "$gw_downloads" "$gw_purge" 2>/dev/null; then
        mkdir -p "$gw_downloads"
        ( rm -rf "$gw_purge" >/dev/null 2>&1 & )
    fi
fi
# Sweep any leftovers from an interrupted purge on a previous boot.
for gw_stale in "${gw_downloads}".purging.*; do
    [ -e "$gw_stale" ] && ( rm -rf "$gw_stale" >/dev/null 2>&1 & )
done
<% if @reclaim_free_space_gb -%>

# The file cache above is generic-worker's own. Two OS-owned caches -- the Rosetta
# 2 AOT cache and CoreSymbolication -- grow unbounded too, are invisible to the
# worker, and had taken 12 of 26 gecko-t-osx-1500-m-vms slots out of production by
# 2026-08-13. Run after the purges above so the free-space reading reflects them,
# and threshold-gated inside the script so it is a no-op where there is headroom.
# Needs root, hence sudo: see the sudoers rule in
# roles_profiles::profiles::cltbld_user.
#
# Emitted only for roles that set worker.reclaim_free_space_gb. Roles that do not
# render this file exactly as they did before the reclaim work landed.
if [ -x /usr/local/bin/reclaim_worker_caches.sh ]; then
    sudo /usr/local/bin/reclaim_worker_caches.sh <%= @reclaim_free_space_gb %>
else
    echo "reclaim_worker_caches.sh not found, skipping OS cache reclaim."
fi
<% end -%>

<% if @purge_metal_shader_cache -%>
# https://bugzilla.mozilla.org/show_bug.cgi?id=2072152 (and 1927416 before it)
# Metal keeps a compiled-shader cache per app bundle under the task user's Darwin
# cache dir, and loading a populated one is not free. On the Intel 14.70 testers the
# first shader compile of a run stalled ~500ms behind a warm cache, which lands
# straight in cold-pageload numbers for any test whose page holds a canvas: enabling
# Metal ANGLE for WebGL showed up as medium-to-large regressions across the cold
# suites until the cache was cleared, after which the same compile takes a few
# milliseconds. The arm64 15.x testers do not show it, so this is opt-in per role
# rather than fleet-wide -- see worker_runner::purge_metal_shader_cache.
#
# Scope is deliberately narrow: only com.apple.metal inside Firefox's own cache
# dirs, matching the harness-side purge that bug 2072152 verified by perfcompare.
# The rest of each org.mozilla.* dir, and every other app's Metal cache, is left
# alone. The org.mozilla.* glob is load-bearing rather than tidy -- ANGLE compiles
# in the GPU process, whose cache dir is org.mozilla.firefox-gpu-helper, not
# org.mozilla.firefox.
#
# This cleanup has been attempted twice before and both attempts dictate the shape
# of this one. #775 ran `find /private/var/folders/ -path '*/C/org.mozilla.*'` as
# the non-admin task user: that walks every user's cache dir, so it logged
# `Permission denied` for each one the task user does not own and slowed worker
# startup, and #922 removed it. Asking getconf for the cache dir instead names the
# single directory we already own and traverses no one else's, so there is nothing
# to be denied and no scan to pay for.
#
# Runs inline, not detached like the downloads purge above: the point is that the
# cache is gone before start-worker claims a task, and a handful of shader-cache
# dirs is a cheap rm rather than the ~20k-file backlog that made detaching
# necessary there.
#
# Not in macos_directory_cleaner's clean_before_reboot.sh, which is the other place
# path cleanup lives, for three reasons. It runs as root (`su - root -c` in
# org.mozilla.cleanbeforereboot.plist), so getconf there resolves root's cache dir
# rather than the task user's -- reintroducing the wrong-user mistake this rewrite
# exists to avoid. It is a RunAtLoad LaunchDaemon, so it is unordered against
# start-worker, and a purge that races the task it is meant to precede buys nothing;
# the same plist was already observed not loaded on at least one host, which for a
# perf fix means regressions quietly come back with no signal. And directory_cleaner
# is an age-and-config-driven retention tool, where what is wanted here is an
# unconditional rm of one known directory before every task.
<% if @generic_worker_engine == 'multiuser-static' -%>
# DARWIN_USER_CACHE_DIR is per-uid, and on multiuser-static this script is a root
# LaunchDaemon while tasks run as <%= @task_user %>, so ask for that user's dir
# rather than root's.
metal_cache_root=$(/usr/bin/sudo -u <%= @task_user %> /usr/bin/getconf DARWIN_USER_CACHE_DIR 2>/dev/null)
<% else -%>
# DARWIN_USER_CACHE_DIR is per-uid, and on the simple engine this script already
# runs as <%= @task_user %> -- the same user the task runs as -- so our own cache
# dir is the one the task will use.
metal_cache_root=$(/usr/bin/getconf DARWIN_USER_CACHE_DIR 2>/dev/null)
<% end -%>
if [ -n "$metal_cache_root" ] && [ -d "$metal_cache_root" ]; then
    # getconf returns the path with a trailing slash.
    for metal_cache in "${metal_cache_root%/}"/org.mozilla.*/com.apple.metal; do
        [ -d "$metal_cache" ] || continue
        echo "Clearing Metal shader cache: $metal_cache"
        rm -rf "$metal_cache"
    done
else
    echo "Could not resolve DARWIN_USER_CACHE_DIR, skipping Metal shader cache purge."
fi
<% end -%>

# https://bugzilla.mozilla.org/show_bug.cgi?id=1967525
if [ -x  /usr/local/bin/lsdb.py ]; then
    python3 /usr/local/bin/lsdb.py --delete-stale
else
    echo "lsdb.py not found, skipping launch services cleanup."
fi
<% if @skip_reboot_between_tasks -%>

# The task-user paths macos_directory_cleaner's clean_before_reboot.sh empties at
# boot. That only runs once per boot, so do it here every cycle too. Its root-only
# paths (oah, coresymbolicationd) are still left to it and the periodic reboot.
for user_dir in "/Users/<%= @task_user %>/Library/Caches/Mozilla/updates" \
                "/Users/<%= @task_user %>/Downloads" \
                "/Users/<%= @task_user %>/Desktop" \
                "/Users/<%= @task_user %>/Library/Application Support/Firefox/Crash Reports"; do
    if [ -d "$user_dir" ] && [ ! -L "$user_dir" ]; then
        find "$user_dir" -mindepth 1 -delete 2>/dev/null
    fi
done
<% end -%>

if [ -x /usr/local/bin/run-puppet.sh ]; then
    sudo /usr/local/bin/run-puppet.sh
else
    echo "run-puppet.sh not found, skipping Puppet run."
fi

if [[ "<%= @generic_worker_engine %>" == "multiuser-static" ]]; then
    # Run worker from <%= @gw_root_dir %> when in multiuser-static mode
    cd <%= @gw_root_dir %>
fi

# Quit any Safari or Safari Technology Preview already open for the task user
# before the worker claims a task. safaridriver launches its own instance; if a
# normal (non-automation) one is already running it asks that one for an
# automation session instead, which never answers, and every browsertime Safari
# task fails after exhausting its retries with:
#   Could not create a session: The session timed out while connecting to a
#   Safari instance.
# On macOS 27 this became a loop: a task ends with Safari open, the host reboots,
# macOS Resume (loginwindow's TAL launch) reopens it at login, and the next task
# times out and reboots with it still open. clean_appstate_13_plus's empty,
# root-owned ByHost loginwindow plist stops the relaunch on 14/15 but not on 27,
# and TALLogoutSavesState=false does not stop it either (both verified on
# macmini-m4-130, 2026-09-24). Harmless where Safari is not running.
#
# Resume relaunches when the task user's session comes up, so wait for that
# session (its Dock) first -- but only on hosts that autologin as the task user,
# so headless roles sharing this script are not delayed.
# Anchored to the start of the command line so it matches the Safari executables
# only: raptor and browsertime pass the Safari binary path as an argument, and an
# unanchored pgrep -f matches the test harness too.
safari_pattern='^/[^ ]*/Safari\.app/Contents/MacOS/Safari( |$)|^/Applications/Safari Technology Preview\.app/Contents/MacOS/Safari Technology Preview( |$)'
if [ "$(/usr/bin/defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)" = "<%= @task_user %>" ]<% if @skip_reboot_between_tasks %> && [ "$tasks_since_boot" -eq 0 ]<% end %>; then
    for _ in $(seq 1 60); do
        /usr/bin/pgrep -u <%= @task_user %> -x Dock >/dev/null && break
        sleep 2
    done
    sleep 5
fi
for _ in 1 2 3; do
    /usr/bin/pgrep -u <%= @task_user %> -f "$safari_pattern" >/dev/null || break
    echo "Quitting Safari left open for <%= @task_user %> before starting the worker"
    /usr/bin/pkill -TERM -u <%= @task_user %> -f "$safari_pattern"
    sleep 3
    /usr/bin/pkill -KILL -u <%= @task_user %> -f "$safari_pattern"
    sleep 2
done
<% if @skip_reboot_between_tasks -%>

# Everything the task user is running before the first task of this boot is the
# login session; anything new after a task is the task's.
if [ -z "$baseline_procs" ]; then
    list_task_processes
    while read -r pid ppid comm; do
        baseline_procs="${baseline_procs}${pid} ${comm}"$'\n'
    done < "$proc_list"
fi
touch "$iteration_marker"
worker_log=<%= @log_dir %>/stderr.log
worker_log_offset=$(stat -f%z "$worker_log" 2>/dev/null || echo 0)
<% end -%>

# First run worker runner, passing through any arguments handed to this
# wrapper script...
/usr/local/bin/start-worker "$@"

exitstatus="${PIPESTATUS[0]}"

# TODO: add logic to remove sempaphore only if puppet is running atboot
# Remove semaphore file to ensure worker runner does not start before puppet
# rm -f "/var/tmp/semaphore/run-buildbot"

# If generic-worker considers that the host environment is in an invalid/corrupted
# state (for example, it cannot write to disk), it will return the exit code 69.
#
# More information about generic-worker exit codes can be seen here:
# https://docs.taskcluster.net/docs/reference/workers/generic-worker#set-up-your-env
last_failed_semaphore=<%= @data_dir %>/worker_exit_69
if [ $exitstatus -eq 69 ]; then
    if [ -f $last_failed_semaphore ]; then
        if [[ $(find "$last_failed_semaphore" -mmin +15 -print) ]]; then
            echo "Problem repeated for 15m. Sleep 10m ..."
            sleep 600
        else
            echo "Worker repeat exit code 69. Sleep 120s ..."
            sleep 120
        fi
    else
        echo "Exit code 69. Sleep 60s ..."
        printf "$(date) ${exitstatus}" > $last_failed_semaphore
        sleep 60
    fi
elif [ $exitstatus -gt 69 -o $exitstatus -lt 69 ]; then
    if [ -f $last_failed_semaphore ]; then
        echo "Worker recovered from previous exit code 69."
        cat $last_failed_semaphore
        rm -f $last_failed_semaphore
    fi
fi

if test $(find $last_premature_end -mmin +1); then
    rm -f $last_premature_end
else
    echo "Started less than 60s ago. Sleeping 30s"
    sleep 30
fi
<% if @skip_reboot_between_tasks -%>

<% if @generic_worker_engine == 'multiuser-static' -%>
resolved_count_file=<%= @gw_root_dir %>/tasks-resolved-count.txt
<% else -%>
resolved_count_file=<%= @data_dir %>/tasks-resolved-count.txt
<% end -%>
resolved=0
if [ -f "$resolved_count_file" ]; then
    resolved=$(tr -dc '0-9' < "$resolved_count_file" 2>/dev/null)
fi

# Only a clean success loops. A failed or excepted task is the likeliest to have
# left a mess, and failures are rare enough that rebooting after them costs little.
# generic-worker logs "Task <id> finished successfully!" only for a passing task.
reboot_reason=""
if [ "$exitstatus" -ne 0 ]; then
    reboot_reason="worker exited ${exitstatus}"
elif [ "${resolved:-0}" -lt 1 ]; then
    reboot_reason="no task resolved this cycle"
elif ! tail -c +$((worker_log_offset + 1)) "$worker_log" 2>/dev/null | grep -aq 'finished successfully!'; then
    reboot_reason="task did not finish successfully"
else
    tasks_since_boot=$((tasks_since_boot + 1))
    if [ "$tasks_since_boot" -ge <%= @max_tasks_between_reboots %> ]; then
        reboot_reason="${tasks_since_boot} tasks since boot"
    elif ! reap_strays; then
        reboot_reason="leftover <%= @task_user %> processes survived SIGKILL"
    fi
fi

if [ -z "$reboot_reason" ]; then
    clean_task_temp
    echo "NO REBOOT $(date)  (tasks since boot: ${tasks_since_boot})"
    continue
fi
echo "Rebooting: ${reboot_reason}"
break
done
<% end -%>

<% if @post_task_action == 'halt' -%>
# Per-task reversion (bug 2071007). HALT (so the host's tartworker KeepAlive daemon
# reclones a clean guest) ONLY when a task actually resolved this cycle. On any
# other exit -- first boot before creds are injected, quarantine, idle timeout,
# worker error -- REBOOT instead. A guest reboot keeps `tart run` alive (no
# reclone), so the guest gets to finish first-boot and register. Halting on every
# exit would power a fresh guest off ~90s into first boot, before it can register,
# and the daemon would reclone forever (the loop this gate fixes).
#
# generic-worker writes tasks-resolved-count.txt (removed at the top of this
# script each cycle); a value >= 1 means a real task completed. multiuser* keeps
# it under <%= @gw_root_dir %>, the simple engine under <%= @data_dir %>.
<% if @generic_worker_engine == 'multiuser-static' -%>
resolved_count_file=<%= @gw_root_dir %>/tasks-resolved-count.txt
<% else -%>
resolved_count_file=<%= @data_dir %>/tasks-resolved-count.txt
<% end -%>
resolved=0
if [ -f "$resolved_count_file" ]; then
    resolved=$(tr -dc '0-9' < "$resolved_count_file" 2>/dev/null)
fi
if [ "${resolved:-0}" -ge 1 ]; then
    echo "HALT $(date)  (task resolved=${resolved}; per-task reversion: host reclones a fresh guest)"
    /usr/bin/sudo /sbin/shutdown -h now
else
    echo "REBOOT $(date)  (no task resolved this cycle; rebooting to stabilize, NOT recloning)"
    /usr/bin/sudo /sbin/reboot
fi
<% else -%>
echo "REBOOT $(date)"
/usr/bin/sudo /sbin/reboot
<% end -%>
# Sleep to prevent this script from terminating naturally, and launchd restarting
# it. Instead, the shutdown should cause this script to terminate (so it won't
# really sleep for 2 mins). If shutdown doesn't kick in within 2 mins, it is sane
# for this script to exit, and allow launchd to fire up the worker again.
sleep 120
